# Copy to server/.env and paste the dev token from https://dev.rootapp.com
# Never commit the real file. It is ignored by .gitignore.
DEV_TOKEN=your-dev-token-here

# Optional: where Send feedback notes go, as issues in a private GitHub repo.
# Baked into server/dist by the build, because Root has no secret storage.
# Leave empty to hide the box. Use a fine-grained token limited to that one repo
# with only Issues read/write. See docs/DEPLOYING.md.
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=
