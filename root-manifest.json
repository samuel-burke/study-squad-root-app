{
  "id": "ADIjs4fHiQmWa4Qi7Kaa4w",
  "version": "0.3.7",
  "package": {
    "client": {
      "deploy": "client/dist"
    },
    "server": {
      "launch": "server/dist/main.js",
      "deploy": [
        "server/dist",
        "networking/gen/server",
        "core/dist",
        "core/package.json",
        "contract/dist",
        "contract/package.json"
      ],
      "nodeModules": ["node_modules"]
    }
  },
  "permissions": {
    "channel": {
      "channelView": true,
      "channelCreateMessage": true,
      "channelCreateMessageMention": true
    }
  },
  "settings": {
    "groups": [
      {
        "key": "room",
        "title": "Timer and room",
        "items": [
          {
            "key": "postChannel",
            "title": "Bot messages channel",
            "description": "The text channel where the Squad bot posts, along with daily recaps, busy-room and streak milestone posts. Leave empty to turn all posts off.",
            "channel": {
              "multiSelect": false
            }
          },
          {
            "key": "squadMentions",
            "title": "Bot @mentions",
            "description": "Ping people with an @mention when the Squad bot posts about them. Off shows their names as plain text, with no notification.",
            "checkbox": {
              "defaultValue": false
            }
          },
          {
            "key": "timerPreset",
            "title": "Default room timer",
            "description": "Focus minutes / break minutes. Rounds of 4, then a long break. Changes apply from the next cycle.",
            "select": {
              "multiSelect": false,
              "values": ["25-5"],
              "options": [
                {
                  "key": "25-5",
                  "value": "25 / 5"
                },
                {
                  "key": "50-10",
                  "value": "50 / 10"
                },
                {
                  "key": "custom",
                  "value": "Custom"
                }
              ]
            }
          },
          {
            "key": "customFocusMinutes",
            "title": "Custom focus minutes",
            "description": "Minutes per focus round, 5 to 120. Used when the room timer is set to Custom.",
            "number": {
              "minValue": 5,
              "maxValue": 120,
              "step": 1,
              "defaultValue": 25
            }
          },
          {
            "key": "customBreakMinutes",
            "title": "Custom break minutes",
            "description": "Minutes per short break, 1 to 30. The long break is 3 times this, up to 30. Used when the room timer is set to Custom.",
            "number": {
              "minValue": 1,
              "maxValue": 30,
              "step": 1,
              "defaultValue": 5
            }
          },
          {
            "key": "voiceChannelName",
            "title": "Voice channel name",
            "description": "Easier: pick the voice channel in the app's own Room settings. Or type its name here to show a Join voice button and a headphones icon on members in it. Case, spaces, dashes and emoji don't matter. A channel picked in the app wins over this name.",
            "text": {
              "defaultValue": "",
              "regex": "^.{0,100}$"
            }
          },
          {
            "key": "recapEnabled",
            "title": "Daily recap",
            "description": "Post community hours, goals finished and top streaks once a day.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "recapTime",
            "title": "Recap time",
            "description": "In the community time zone below.",
            "time": {
              "defaultValue": {
                "hours": 21,
                "minutes": 0,
                "seconds": 0
              }
            }
          },
          {
            "key": "recapLeaderboard",
            "title": "Leaderboard in recap",
            "description": "Add the week's top 3 by focus minutes to the daily recap. Members who hid themselves are never listed.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "timeZone",
            "title": "Community time zone",
            "description": "Decides when a day starts for streaks, recaps, the weekly boss and the leaderboard.",
            "select": {
              "multiSelect": false,
              "values": ["America/New_York"],
              "options": [
                {
                  "key": "America/New_York",
                  "value": "America/New York"
                },
                {
                  "key": "America/Chicago",
                  "value": "America/Chicago"
                },
                {
                  "key": "America/Denver",
                  "value": "America/Denver"
                },
                {
                  "key": "America/Los_Angeles",
                  "value": "America/Los Angeles"
                },
                {
                  "key": "America/Anchorage",
                  "value": "America/Anchorage"
                },
                {
                  "key": "Pacific/Honolulu",
                  "value": "Pacific/Honolulu"
                },
                {
                  "key": "America/Toronto",
                  "value": "America/Toronto"
                },
                {
                  "key": "America/Sao_Paulo",
                  "value": "America/Sao Paulo"
                },
                {
                  "key": "Europe/London",
                  "value": "Europe/London"
                },
                {
                  "key": "Europe/Berlin",
                  "value": "Europe/Berlin"
                },
                {
                  "key": "Europe/Paris",
                  "value": "Europe/Paris"
                },
                {
                  "key": "Europe/Madrid",
                  "value": "Europe/Madrid"
                },
                {
                  "key": "Africa/Lagos",
                  "value": "Africa/Lagos"
                },
                {
                  "key": "Africa/Johannesburg",
                  "value": "Africa/Johannesburg"
                },
                {
                  "key": "Asia/Kolkata",
                  "value": "Asia/Kolkata"
                },
                {
                  "key": "Asia/Singapore",
                  "value": "Asia/Singapore"
                },
                {
                  "key": "Asia/Tokyo",
                  "value": "Asia/Tokyo"
                },
                {
                  "key": "Asia/Seoul",
                  "value": "Asia/Seoul"
                },
                {
                  "key": "Australia/Sydney",
                  "value": "Australia/Sydney"
                },
                {
                  "key": "Pacific/Auckland",
                  "value": "Pacific/Auckland"
                },
                {
                  "key": "UTC",
                  "value": "UTC"
                }
              ]
            }
          },
          {
            "key": "goalsPublicByDefault",
            "title": "Show goals by default",
            "description": "Members can always switch theirs to private.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "busyPosts",
            "title": "\"Room is busy\" posts",
            "description": "Post once when enough people are focusing at the same time.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "busyThreshold",
            "title": "Busy room threshold",
            "description": "How many people focusing counts as busy, 2 to 100.",
            "number": {
              "minValue": 2,
              "maxValue": 100,
              "step": 1,
              "defaultValue": 5
            }
          },
          {
            "key": "squadBot",
            "title": "Squad bot",
            "description": "Post a fun message in the bot messages channel when the room timer starts, switches between study and break, or finishes, when someone joins, and when someone unlocks a badge. Names the people in the room.",
            "checkbox": {
              "defaultValue": true
            }
          }
        ]
      },
      {
        "key": "game",
        "title": "Game layer",
        "items": [
          {
            "key": "xpEnabled",
            "title": "XP and levels",
            "description": "2 XP per focus minute, +25 per finished goal.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "comboEnabled",
            "title": "Combo multiplier",
            "description": "More people on the room timer means more XP for all.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "bossEnabled",
            "title": "Weekly boss",
            "description": "A community goal with an HP bar. Every XP members earn deals damage, live each minute they focus, and everyone who pitched in gets bonus XP when it falls. A new boss spawns every Monday.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "bossBaseHpXp",
            "title": "Boss base HP (XP)",
            "description": "HP of a 1x boss. Each boss multiplies it by its strength (0.5x to 2x, averaging 1x) and drops more XP the stronger it is. An hour of focus is 120 XP. Suggested: 2,000 XP per active member. 100 to 1,000,000, in steps of 100.",
            "number": {
              "minValue": 100,
              "maxValue": 1000000,
              "step": 100,
              "defaultValue": 10000
            }
          },
          {
            "key": "streakFreezes",
            "title": "Streak freezes",
            "description": "One free missed day per week.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "milestonePosts",
            "title": "Milestone posts",
            "description": "Celebrate 7, 30, 50, 100 and 365 day streaks in the post channel.",
            "checkbox": {
              "defaultValue": true
            }
          }
        ]
      }
    ]
  }
}
