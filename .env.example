# Copy to server/.env and paste the dev token from https://dev.rootapp.com
# Never commit the real file. It is ignored by .gitignore.
DEV_TOKEN=your-dev-token-here

# Optional: where Send feedback notes go. The address and key of your feedback
# relay (feedback-relay/ on Vercel), which turns notes into GitHub issues. The
# GitHub token stays on the relay. Leave empty to hide the box.
# See docs/DEPLOYING.md.
FEEDBACK_RELAY_URL=
FEEDBACK_RELAY_KEY=
